# Slide Editor Environment Variables (Optional)

# API Endpoint for saving drafts (currently mocked)
# VITE_API_ENDPOINT=/api/slides/draft

# Autosave delay in milliseconds (default: 1500)
# VITE_AUTOSAVE_DELAY=1500

# Maximum number of slides allowed (default: 5)
# VITE_MAX_SLIDES=5

# Canvas dimensions (default: 960x540)
# VITE_CANVAS_WIDTH=960
# VITE_CANVAS_HEIGHT=540
